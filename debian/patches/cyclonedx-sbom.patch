 	doxygen $(top_srcdir)/docs/doxygen.conf
 
+# CycloneDX SBOMs: "sbom" describes this build (third-party code from
+# maintained upstreams compiled in, and the libraries it needs at run
+# time); "source-sbom" describes the source tree (all third-party code
+# and every library the build may use, with accepted version ranges).
+sbom: $(TARGET_LIB)
+	$(SHELL) $(top_srcdir)/build/sbom.sh build \
+	    --srcdir "$(top_srcdir)" --host "@host@" \
+	    --cross "@APR_CROSS_COMPILING@" \
+	    --libs "$(ALL_LIBS)" --objects "$(OBJECTS)" \
+	    --library "$(TARGET_LIB)" --cc "$(CC)" > apr.cdx.json.tmp
+	mv apr.cdx.json.tmp apr.cdx.json
+
+source-sbom:
+	$(SHELL) $(top_srcdir)/build/sbom.sh source "$(top_srcdir)" \
+	    > apr-source.cdx.json.tmp
+	mv apr-source.cdx.json.tmp apr-source.cdx.json
+
 gcov: 
 	@build/run-gcov.sh
 
